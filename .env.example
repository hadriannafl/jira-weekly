# Salin jadi .env lalu isi
JIRA_BASE_URL=https://namaperusahaan.atlassian.net
JIRA_EMAIL=email@kamu.com
# Buat token di https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Data timesheet. TS_NAME kosong = pakai nama akun Jira.
TS_NAME=
TS_DEPARTMENT=IT Developer
TS_PROJECT=TRS(PT.Tiga Raksa Satria),Clien Side
TS_COMPANY=PT. Indocyber Global Teknologi
# Baris alamat di bawah nama perusahaan, dipisah tanda |
TS_COMPANY_LINES=Komplek Pertokoan Aldiron Hero Blok C No 10|Jl. Daan Mogot Kav. 119, Jakarta Barat 11460|Telp. (+62-21) 566 3705, Fax. (+62-21) 566 3704
# Folder berisi logo.png, logo-corner.png, signature.png
TS_ASSETS=assets

# Link Zoom, tampil sebagai tombol di dashboard. Kosongkan kalau tidak perlu.
ZOOM_URL=

# Login dashboard web. Kosongkan WEB_PASSWORD kalau tidak mau pakai login.
WEB_USER=admin
WEB_PASSWORD=
